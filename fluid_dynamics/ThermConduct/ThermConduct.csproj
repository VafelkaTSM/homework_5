<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <!-- Файлы условий копируются рядом с исполняемым файлом: программа читает их при запуске -->
  <ItemGroup>
    <None Update="initial_conditions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="boundary_conditions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

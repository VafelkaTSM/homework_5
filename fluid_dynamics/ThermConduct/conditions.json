{
  // ==========================================================
  //  Условия эксперимента — единый файл conditions.json
  //  (заменяет прежние initial_conditions.json и boundary_conditions.json)
  //
  //  Разрешены комментарии // и /* */, висячие запятые.
  //  Функции (для начального поля и границ) задаются КЛЮЧОМ из словарей
  //  в файле ThermalFunctions.cs; саму функцию дописывают туда под своим ключом.
  // ==========================================================

  // ---- Сетка: количество ячеек и их линейные размеры ----
  "grid": {
    "cells": [16, 16, 16],            // количество ячеек по осям X, Y, Z
    "size": [0.016, 0.016, 0.016]     // линейные размеры области по осям, м
                                      // → шаг сетки h = size/cells = 0.001 м
    // Вместо "size" можно задать шаги напрямую:
    // "cellSize": 0.001                // один шаг на все оси, м
    // "cellSize": [0.001, 0.002, 0.001] // или свой шаг по каждой оси, м
  },

  // ---- Материал ----
  "thermalConductivity": 45.0,        // теплопроводность λ, Вт/(м·К); нужна ГУ 2-го и 3-го рода

  // ---- Метод подсчёта теплопередачи ----
  "method": "explicit",               // ключ из словаря ThermalFunctions.CellUpdateMethods:
                                      //   "explicit"        — явная схема (устойчива при C ≤ 1/6)
                                      //   "dufort-frankel"  — схема Дюфорта–Франкела (устойчива всегда)

  // ---- Начальное условие (один из вариантов) ----
  "initial": {
    "temperature": 300.0              // равномерное поле, К
    // "function": "hot_center"       // ИЛИ ключ функции T(x, y, z) из ThermalFunctions.InitialTemperatures
    // "cells": [[[300, ...], ...]]   // ИЛИ массив [X][Y][Z] — своя температура каждой ячейки, К
  },

  // ---- Граничные условия шести граней ----
  // Виды (type): "dirichlet" — 1-й род (температура стенки, К);
  //              "neumann"   — 2-й род (тепловой поток в тело, Вт/м²; 0 — нулевой градиент, теплоизоляция);
  //              "robin"     — 3-й род (теплообмен со средой: [T среды, К; α, Вт/(м²·К)]).
  // Значение: "value"/"function" — одно на всю грань;
  //           "values"/"functions" — двумерный массив формы грани (x — [Y][Z],
  //           y — [X][Z], z — [X][Y]): своё значение/функция каждой ячейке грани.
  // Элемент — число (константа) или ключ функции времени из ThermalFunctions.BoundaryConditions;
  // у Робина элемент — пара [значение, значение].
  // Сокращённо для 1-го рода: "zPast": 300.0 (число) или [[...], ...] (массив по ячейкам).
  // Пропущенная грань — 300 К.
  "boundaries": {
    // Грань x = min: 1-й род — циклическая функция времени (импульс 300…400 К, период 10 с).
    "xPast": { "type": "dirichlet", "function": "sin_pulse" },

    // Грань x = max: 2-й род — постоянный градиент температуры ∂T/∂x = −10 К/мм
    // (тепло выходит через грань): q = λ·∂T/∂x = 45·(−10000) = −450000 Вт/м².
    "xNext": { "type": "neumann", "value": 0.0 },

    // Грани y = min / y = max: нулевой градиент температуры (теплоизоляция).
    "yPast": { "type": "neumann", "value": 0.0 },
    "yNext": { "type": "neumann", "value": 0.0 },

    // Грани z = min / z = max: нулевой градиент температуры (теплоизоляция).
    "zPast": { "type": "neumann", "value": 0.0 },
    "zNext": { "type": "neumann", "value": 0.0 }
  }
}

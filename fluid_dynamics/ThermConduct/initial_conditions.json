{
  // ---- Начальные условия (initial_conditions.json) ----
  // Размеры сетки в ячейках: [X, Y, Z]. Нужны, если поле температур задано одним числом.
  "shape": [16, 16, 16],

  // Шаг сетки h, м — расстояние между центрами соседних ячеек.
  "cellSize": 0.001,

  // Начальное распределение температур.
  // Одно число = равномерное поле (температура одинакова во всех ячейках), К.
  // Именно этот вариант используется по умолчанию: всё поле 300 К.
  "temperature": 300.0

  // Необязательная замена равномерного поля на массив [X][Y][Z]:
  // "cells": [
  //   [ [300, 300, ...], [300, 300, ...], ... ],   // слой x = 0
  //   [ ... ]                                      // слой x = 1 и т.д.
  // ]
  // Если "cells" задан, "temperature" не используется, а размеры берутся из массива
  // ("shape" при этом только проверяется на совпадение).
}
